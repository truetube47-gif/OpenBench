# ── Environment ──────────────────────────────────────────────────────────
ENV=development                          # development | production | testing
FRONTEND_URL=http://localhost:3000

# ── Hugging Face ─────────────────────────────────────────────────────────
# Free at https://huggingface.co/settings/tokens
# Without this you hit anonymous rate limits (250 req/day). With it: 5000/day
HF_TOKEN=

# ── Wolfram (optional) ──────────────────────────────────────────────────
# Symbolic memory formula derivation
WOLFRAM_APP_ID=
WOLFRAM_CLOUD_KEY=

# ── Database ─────────────────────────────────────────────────────────────
OPENBENCH_DATABASE_URL=sqlite+aiosqlite:///./openbench.db

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Cache ────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=3600

# ── Rate Limiting ────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_ANALYZE=15/minute

# ── Request Size ─────────────────────────────────────────────────────────
MAX_REQUEST_BODY_MB=3

# ── External ─────────────────────────────────────────────────────────────
HF_LEADERBOARD_DATASET=open-llm-leaderboard/results
